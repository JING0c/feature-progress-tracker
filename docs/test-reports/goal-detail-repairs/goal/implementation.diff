+def planning_goal(content):
+    """Read explicit goal prose/fields without treating code or features as goals."""
+    goal_label = re.compile(r'目标(?!用户|人群|客户)|\b(?:goals?|objectives?)\b', re.I)
+    goal_field = re.compile(r'^(?:(?:项目|主要|辅助|业务|产品)?目标|(?:project\s+)?(?:goals?|objectives?))$', re.I)
+    other_label = re.compile(r'非目标|范围|边界|约束|功能|验收|风险|技术|准备|'
+                             r'\b(?:non[- ]?goals?|scope|features?|acceptance|risks?)\b', re.I)
+    placeholder = re.compile(r'^(?:待(?:补充|完善|规划|填写|编写|定义|确定|确认|定)|'
+                             r'(?:请|在此)?(?:填写|补充|描述)(?:项目)?目标|'
+                             r'尚未生成|未生成|todo\b|tbd\b|暂无|无$)', re.I)
+    values, sections = [], []
+
+    def append(value):
+        value = re.sub(r'\s+', ' ', value).strip()
+        if value and not placeholder.search(value) and value not in values:
+            values.append(value)
+
+    for block in _blocks(content.splitlines()):
+        kind = block['type']
+        if kind == 'heading':
+            while sections and sections[-1][0] >= block['level']:
+                sections.pop()
+            active = bool(goal_label.search(block['text']))
+            if other_label.search(block['text']):
+                active = False  # Mixed sections require an explicit goal field.
+            elif not active and sections:
+                active = sections[-1][1]
+            sections.append((block['level'], active))
+        elif kind == 'table':
+            columns = [n for n, title in enumerate(block['columns']) if goal_field.fullmatch(title.strip())]
+            labelled = any(row and goal_field.fullmatch(row[0].strip()) for row in block['rows'])
+            for row in block['rows']:
+                if columns:
+                    for n in columns:
+                        append(row[n])
+                elif row and goal_field.fullmatch(row[0].strip()):
+                    for value in row[1:]:
+                        append(value)
+                elif not labelled and sections and sections[-1][1] and not (row and other_label.search(row[0])):
+                    for value in row:
+                        append(value)
+        elif kind in ('paragraph', 'list'):
+            for line in block['text'].splitlines():
+                if line.lstrip().startswith(('>', '<!--')):
+                    continue
+                field = re.match(r'^([^：:]{1,40})[：:]\s*(.*)$', line)
+                if field and goal_field.fullmatch(field[1].strip()):
+                    append(field[2])
+                elif sections and sections[-1][1] and not (field and other_label.search(field[1])):
+                    append(line)
+    return '；'.join(values)
+
