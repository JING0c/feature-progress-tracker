          "text": "1: const { Suite } = require('benchmark');\n2: const cursor = require('ansi')(process.stdout);\n3: const fixtures = require('./fixtures');\n4: \n5: const cycle = (e, nl) => {\n6:   cursor.eraseLine();\n7:   cursor.horizontalAbsolute();\n8:   cursor.write('' + e.target);\n9:   if (nl) cursor.write('\\n');\n10: };\n11: \n12: function bench(name) {\n13:   const suite = new Suite()\n14:     .on('start', () => console.log(`# ${name}`))\n15:     .on('complete', function(e) {\n16:       const fastest = this.filter('fastest').map('name').toString();\n17:       console.log(`fastest is '${fastest}'`);\n18:       console.log();\n19:     })\n20: \n21:   const res = {\n22:     run: suite.run.bind(suite),\n23:     add(key, fn) {\n24:       suite.add(key, {\n25:         onCycle: e => cycle(e),\n26:         onComplete: e => cycle(e, true),\n27:         fn\n28:       });\n29:       return res;\n30:     }\n31:   };\n32:   return res;\n33: }\n34: \n35: function run(fn, prop = 'all') {\n36:   [].concat(fixtures[prop]).forEach(val => fn(val));\n37: }\n38: \n39: bench('all')\n40:   .add('v6.1', () => run(isNumber61))\n41:   .add('v6.0', () => run(isNumber60))\n42:   .add('parseFloat', () => run(isNumberParseFloat))\n43:   .run()\n44: \n45: bench('string')\n46:   .add('v6.1', () => run(isNumber61, 'string'))\n47:   .add('v6.0', () => run(isNumber60, 'string'))\n48:   .add('parseFloat', () => run(isNumberParseFloat, 'string'))\n49:   .run()\n50: \n51: bench('number')\n52:   .add('v6.1', () => run(isNumber61, 'number'))\n53:   .add('v6.0', () => run(isNumber60, 'number'))\n54:   .add('parseFloat', () => run(isNumberParseFloat, 'number'))\n55:   .run()\n56: \n57: function isNumberParseFloat(n) {\n58:   if (typeof num === 'number') {\n59:     return num - num === 0;\n60:   }\n61:   if (typeof num === 'string') {\n62:     return (num - parseFloat(num)) > -1;\n63:   }\n64:   return false;\n65: }\n66: \n67: function isNumber60(val) {\n68:   let number = +val;\n69:   // Discard Infinity and NaN\n70:   if ((number - number) !== 0) return false;\n71:   if (number === val) return true;\n72:   if (typeof val === 'string') {\n73:     // whitespace and empty strings are coerced to 0\n74:     // If number is 0, trim the string to see if its empty.\n75:     if (number === 0 && val.trim() === '') {\n76:       return false;\n77:     }\n78:     return true;\n79:   }\n80:   return false;\n81: }\n82: \n83: function isNumber61(val) {\n84:   if (typeof num === 'number') {\n85:     return num - num === 0;\n86:   }\n87:   if (typeof num === 'string' && num.trim() !== '') {\n88:     return Number.isFinite ? Number.isFinite(+num) : isFinite(+num);\n89:   }\n90:   return false;\n91: }\n92: "
