+def sync_ledger_goal(text, goal):
+    """Update only the top-level goal field; leave other metadata and history alone."""
+    if not goal:
+        return text
+    # The target field shares a line with optional ``| 更新：...`` metadata.
+    # Keep goal punctuation literal in Markdown, never a metadata delimiter.
+    # Fullwidth pipes are not Markdown-escapable, so use their character entity.
+    encoded_goal = goal.replace('\\', '\\\\').replace('|', r'\|').replace('｜', '&#65372;')
+    lines, fence, insertion = text.splitlines(keepends=True), None, 0
+    for index, line in enumerate(lines):
+        marker = _FENCE.match(line.rstrip())
+        if fence:
+            if marker and marker[1][0] == fence[0] and len(marker[1]) >= len(fence) and not marker[2].strip():
+                fence = None
+            continue
+        if marker:
+            fence = marker[1]
+            continue
+        heading = _HEADING.match(line.rstrip())
+        if heading:
+            if len(heading[1]) >= 2:
+                break
+            insertion = index + 1
+        field = re.match(r'^( {0,3}(?:项目)?目标[：:][ \t]*)(.*?)(\r?\n)?$', line)
+        if field:
+            body, suffix = field[2], ''
+            # Recognize an old unescaped goal when it exactly matches this plan.
+            # Otherwise only unescaped separators may introduce header fields.
+            start = len(goal) if body.startswith(goal) else 0
+            for separator in re.finditer(r'[|｜][ \t]*(?:更新(?:日期|时间)?|最后更新|进度|负责人|状态|版本)[：:]', body[start:]):
+                index_ = start + separator.start()
+                prefix = body[:index_]
+                if (len(prefix) - len(prefix.rstrip('\\'))) % 2:
+                    continue
+                suffix = body[index_ - (len(prefix) - len(prefix.rstrip(' \t'))):]
+                break
+            lines[index] = field[1] + encoded_goal + suffix + (field[3] or '\n')
+            return ''.join(lines)
+    lines.insert(insertion, '目标：' + encoded_goal + '\n')
+    return ''.join(lines)
+
